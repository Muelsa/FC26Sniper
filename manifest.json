{
  "manifest_version": 3,
  "name": "FC Sniper by SaDizz",
  "version": "1.0",
  "description": "Snipe like a bomber!",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "fc26.js"
  },
  "action": {
    "default_title": "FC26"
  }
}
