{
  "manifest_version": 3,
  "name": "FC Sniper by SaDizz",
  "version": "2.6.2",
  "description": "Snipe like a bomber!",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "alarms",
    "declarativeNetRequest",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.ea.com/*",
    "https://utas.mob.v1.prd.futc-ext.gcp.ea.com/*",
    "https://*.data.ea.com/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "https://www.futwiz.com/*",
    "https://api.telegram.org/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "fc26.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ea.com/*ea-sports-fc/ultimate-team/web-app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pin-bridge.js"],
      "matches": [
        "https://www.ea.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "FC27"
  }
}
